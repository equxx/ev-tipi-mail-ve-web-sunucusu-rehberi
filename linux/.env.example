# Bu dosyayı .env adıyla kopyalayın ve örnek alan adını değiştirin.
COMPOSE_PROJECT_NAME=evsunucu

# Sürümleri bilinçli şekilde sabit tutuyoruz; yükseltmeden önce yedek alın.
MAIL_IMAGE=docker.io/mailserver/docker-mailserver:15.1.0
ROUNDCUBE_IMAGE=roundcube/roundcubemail:1.7.2-apache
DB_IMAGE=mariadb:11.4
NGINX_IMAGE=nginx:1.27-alpine

MAIL_DOMAIN=example.test
MAIL_HOSTNAME=mail.example.test
MAIL_SSL_TYPE=self-signed

# Güvenli yerel varsayılanlar. Dışarı açmadan önce firewall/router kontrolü yapın.
MAIL_BIND_IP=127.0.0.1
SMTP_PORT_BIND=25
SUBMISSION_PORT_BIND=587
IMAPS_PORT_BIND=993
WEB_BIND_IP=127.0.0.1
WEB_PORT=8088
