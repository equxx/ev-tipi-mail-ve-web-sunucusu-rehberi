# Kopyalayıp server.env adıyla kullanın. Gerçek sırları bu dosyaya koymayın.

# Alan adı ve servis adları
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
WEB_HOSTNAME=example.com

# Sunucunun modem arkasındaki sabit LAN adresi ve yerel ağ aralığı
SERVER_LAN_IP=192.168.1.10
LAN_CIDR=192.168.1.0/24

# Bilgi amaçlı; boş kalabilir
PUBLIC_IP=
TIMEZONE=Europe/Istanbul

# TLS sertifikası hazırsa yolları doldurun; boş bırakılırsa TLS satırları değişmez.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Roundcube için yalnızca isimler; parolaları buraya yazmayın.
ROUNDCUBE_DB=roundcube
ROUNDCUBE_DB_USER=roundcube
