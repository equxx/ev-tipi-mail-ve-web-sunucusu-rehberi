# Roundcube 1.7+ için örnek Nginx server bloğu.
# ROUNDCUBE_ROOT ve mail.example.com değerlerini gerçek yollarla değiştirin.
server {
    listen 80;
    listen [::]:80;
    server_name mail.example.com;

    root /var/www/roundcube/public_html;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    location ~ ^/(?:config|temp|logs)(?:/|$) {
        deny all;
    }

    location ~ /\. {
        deny all;
    }
}
